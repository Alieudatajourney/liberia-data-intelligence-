# =============================================================================
# Liberia Data Intelligence — Environment Variables
# =============================================================================
#
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your values in .env
#   3. Never commit .env to version control (it is in .gitignore)
#
# The backend (config.py) reads these values automatically.
# The frontend (streamlit_app.py) reads API_BASE_URL.
# =============================================================================


# --- Application ---
APP_ENV=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR


# --- Database (PostgreSQL) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for local development with default PostgreSQL install:
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/liberia_data


# --- Frontend ---
# Where is the FastAPI backend running?
# The Streamlit dashboard uses this to connect to the API.
API_BASE_URL=http://localhost:8000


# --- AI Layer (optional) ---
# Required only for the /api/v1/query endpoint.
# Leave blank to run without AI features.
# Get a key at: https://console.anthropic.com
ANTHROPIC_API_KEY=
