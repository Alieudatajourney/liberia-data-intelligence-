# =============================================================
# .gitignore — Liberia Data Intelligence
# =============================================================

# --- Secrets (NEVER commit these) ---
.env
*.key
*.pem

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/

# --- Data files ---
# Raw source files may contain sensitive or large data
data/raw/
data/processed/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Streamlit ---
.streamlit/

# --- Logs ---
*.log
logs/
